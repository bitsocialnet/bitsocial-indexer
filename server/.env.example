# bitsocial-indexer server configuration.
# All settings are plain environment variables — export them, set them in your
# process manager / docker-compose, or copy this file to .env and load it with
# your tooling of choice (the server itself does not read .env files).

# ── HTTP API ─────────────────────────────────────────────────────────────────
#PORT=4000
#HOST=0.0.0.0

# CORS allow-list, comma-separated ("*" = any origin — fine for a public
# read-only API). An entry may contain "*" as a wildcard, so one entry covers
# every branch-scoped dev origin instead of listing each worktree by hand:
#   ALLOWED_ORIGINS=https://5archive.org,https://*.seedit.localhost
# CORS_ORIGIN is accepted as a legacy fallback.
#ALLOWED_ORIGINS=*

# ── storage ──────────────────────────────────────────────────────────────────
# SQLite file path, or ":memory:" for an ephemeral index.
#DB_PATH=./data/indexer.db

# ── crawler ──────────────────────────────────────────────────────────────────
# bitsocial-cli daemon RPC endpoint (PKC over WebSocket).
#PKC_RPC_URL=ws://localhost:9138

# What to index. BOTH empty by default → the indexer serves nothing.
# COMMUNITIES is a comma-separated list of addresses; COMMUNITIES_SOURCE is a
# URL or file path to a JSON list (["a.bso", …], {"communities": [...]} or a
# directory file's {"boards": [...]}; objects need only an `address`).
#COMMUNITIES=art.bso,tech.bso
#COMMUNITIES_SOURCE=./communities.json

#CRAWL_INTERVAL_MS=60000
#CRAWL_CONCURRENCY=4
#CRAWL_TIMEOUT_MS=300000
#CRAWL_MAX_PAGES=20
#CRAWL_MAX_REPLY_DEPTH=6

# ── operator takedowns ───────────────────────────────────────────────────────
# An archive keeps serving content after it disappears from the source network,
# so upstream moderation can no longer reach it. BLOCKLIST_SOURCE points at a
# JSON file of CIDs this instance must stop serving (DMCA, illegal content):
#
#   [
#     "QmSomeCommentCid",
#     { "cid": "QmSomePostCid", "scope": "thread", "reason": "DMCA #123" }
#   ]
#
# scope defaults to "comment"; "thread" redacts the post AND all its replies.
# Add a CID and it is redacted within a minute (the file is re-read whenever it
# changes — no restart); remove the entry and the stored content serves again.
# Blocklisted comments stay in threads as redacted tombstones (takedown: 1 plus
# the optional reason on the API), leave listings/search, and stay redacted
# across re-crawls. Content columns are never destroyed — fully reversible.
#BLOCKLIST_SOURCE=./blocklist.json

# ── NSFW communities ─────────────────────────────────────────────────────────
# community.features.safeForWork is the protocol's own, owner-declared answer,
# and it is optional — so it has three states: true, false, and never set. The
# indexer resolves each community's nsfw flag from four signals, highest first:
#   1. this file,
#   2. community.features.safeForWork (false = NSFW), read on every crawl,
#   3. the directory verdict from DIRECTORY_DEFAULTS_SOURCE below,
#   4. inference — any indexed comment in the community is flagged nsfw.
# An unset safeForWork falls through to the next signal, never to a verdict.
#
#   [
#     "adult.bso",
#     { "address": "art.bso", "nsfw": false, "reason": "one flagged post" }
#   ]
#
# nsfw defaults to true; an explicit false clears the flag, so an operator can
# correct a bad verdict. The file is re-read whenever it changes (no restart).
# The resolved flag is served on /api/communities and drives the /api/search
# `nsfw` parameter, which excludes NSFW results unless asked otherwise.
#NSFW_OVERRIDES_SOURCE=./nsfw-overrides.json

# Bitsocial clients state a directory's SFW status once, by directory code, in
# their <prefix>-directories-defaults.json; the sibling <prefix>-<code>-
# directory.json files hold that directory's candidate addresses. Point this at
# the defaults file and the crawler reads both, giving every address listed
# under a directory that directory's features.safeForWork. It answers for the
# many communities whose owner never set the feature themselves.
#DIRECTORY_DEFAULTS_SOURCE=https://raw.githubusercontent.com/bitsocialnet/lists/master/5chan-directories/5chan-directories-defaults.json

# ── misc ─────────────────────────────────────────────────────────────────────
# Load neutral demo data on boot (same as `npm run seed`).
#SEED_DEMO=false

#SITE_NAME=Bitsocial Indexer
#SITE_URL=http://localhost:4000
