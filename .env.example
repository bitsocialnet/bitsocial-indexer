# ─── bitsocial-indexer ────────────────────────────────────────────────────
# Copy to .env in server/ (and/or webui/) and adjust. Nothing here is required;
# the defaults run an empty, local-only indexer.

# ── server/ ──────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# SQLite database file. Use ":memory:" for an ephemeral demo.
DB_PATH=./data/indexer.db

# The bitsocial-cli daemon to crawl through (PKC RPC over WebSocket).
PKC_RPC_URL=ws://localhost:9138

# WHAT TO INDEX — both empty by default (the indexer then serves nothing).
#   COMMUNITIES        comma-separated addresses
#   COMMUNITIES_SOURCE url/path to a JSON array of addresses (e.g. a directory)
COMMUNITIES=
COMMUNITIES_SOURCE=

# How often (ms) to re-crawl each configured community.
CRAWL_INTERVAL_MS=60000

# Load demo communities + posts on boot (same data as `npm run seed`).
SEED_DEMO=false

# Branding / SEO for the bundled UI + sitemap.
SITE_NAME=Bitsocial Indexer
SITE_URL=http://localhost:4000

# CORS allow-list for the API, comma-separated ("*" = any origin — fine for a
# public read-only API). E.g. ALLOWED_ORIGINS=https://5archive.org
# An entry may contain "*" as a wildcard, e.g. https://*.seedit.localhost
# (CORS_ORIGIN is accepted as a legacy fallback.)
ALLOWED_ORIGINS=*

# Operator NSFW verdicts: a JSON file of communities this instance treats as
# NSFW (or explicitly not NSFW). Outranks the community list's own nsfw flag and
# inference from flagged comments. Hot-reloaded like BLOCKLIST_SOURCE.
NSFW_OVERRIDES_SOURCE=

# ── webui/ ───────────────────────────────────────────────────────────────
# Where the web UI reads the API from (server-side fetch).
INDEXER_API=http://localhost:4000

# Public origin of the web UI itself (no trailing slash) — canonical URLs,
# OpenGraph tags, robots.txt and the sitemap index. E.g. https://5archive.org
#SITE_URL=http://localhost:3000

# Header branding for the web UI (SITE_NAME is shared with the server above).
#SITE_BADGE=Indexer

# Web UI skin: "default" (Bitsocial dark) or "5chan" (classic imageboard look).
#THEME=default

# Optional footer attribution, e.g. "A Bitsocial Forge product" + link.
# Nothing is rendered unless BRAND_TEXT is set.
#BRAND_TEXT=
#BRAND_URL=
